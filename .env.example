# BiasharaAssist environment variables. Copy this file to .env and fill in
# real values. Never commit the real .env — it is gitignored.

# Hugging Face read-scoped access token. Required to download
# meta-llama/Meta-Llama-3.1-8B-Instruct (a gated model): create at
# huggingface.co -> Settings -> Access Tokens, after your Llama access
# request on huggingface.co/meta-llama/Meta-Llama-3.1-8B-Instruct is
# approved. Used by fine_tune.py (on RunPod), merge_model.py, and
# evaluate_models.py (all three download the gated base model). NOT
# needed by local_inference.py — it only reads the already-merged local
# model directory, no gated download involved.
HF_TOKEN=hf_your_token_here

# Base model to fine-tune. The Instruct variant follows the chat/messages
# format and instruction-following behaviour this dataset is built around;
# the plain (non-Instruct) base model shows a larger base-vs-fine-tuned
# evaluation gap but follows the trained response format less reliably.
BASE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# --- LLM judge (evaluate_models.py) ---
# This project's judge runs on OpenRouter (OpenAI-API-compatible), matching
# the provider used throughout this course's earlier labs.
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=openai/gpt-4o-mini
# Get a key at https://openrouter.ai/keys — put the real key only in .env,
# never here.
JUDGE_API_KEY=sk-or-your-openrouter-key-here
